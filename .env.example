# Use "demo" to run without an external AI API.
# Use "openai" only after adding a valid API key to your private .env file.
APP_MODE=demo

# Copy this file to .env before running the application.
OPENAI_API_KEY=

# The model can be changed without editing the Python code.
OPENAI_MODEL=gpt-4.1-mini

APP_NAME=Day 8 Job Match Agent
MAX_INPUT_CHARACTERS=20000